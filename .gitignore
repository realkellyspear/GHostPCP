# Virtual environment & Python cache
.venv/
__pycache__/
*.py[cod]

# Build artifacts & external native DLLs
build_pcp/
backends/
*.spec
*.exe
!assets/*

# Local GGUF models (keep the folder and its README for GitHub)
ghost_models/*
!ghost_models/README.md
*.gguf
*.safetensors

# Local Piper TTS voice models (keep the folder and its README for GitHub)
piper_models/*.onnx
